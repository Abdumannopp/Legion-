PORT=8000
FRONTEND_URL=http://localhost:3000
# Leave empty and run `npm run setup`: it writes a random value.
# The server refuses to start with template values (replace-with…, change-me…).
JWT_SECRET=
# Recognises bank accounts in the payment check without storing them (HMAC key). REQUIRED in
# production: openssl rand -hex 32. Its own value — never JWT_SECRET or the webhook secret.
# After rotating, list the old key in PAYMENT_HASH_PREVIOUS_KEYS so confirmed accounts still match.
PAYMENT_HASH_KEY=
# Signs the SOC audit chain. REQUIRED in production (openssl rand -hex 32), its own value. To rotate:
# new value here, old value in SOC_AUDIT_PREVIOUS_KEYS ("jwt" = the key installs without it used).
SOC_AUDIT_KEY=
# SOC_AUDIT_PREVIOUS_KEYS=
# PAYMENT_HASH_PREVIOUS_KEYS=
COOKIE_SECURE=false
# The /auth/refresh path as the browser sees it. Direct: /auth.
# Behind nginx ("/api" is stripped): /api/auth — otherwise the refresh
# cookie never comes back from the browser and the session ends when the access token expires.
REFRESH_COOKIE_PATH=/auth
# Which proxy may tell the client's real IP (X-Forwarded-For).
# Empty = loopback only (nginx on this server). "none" = nobody.
# "1" = the last single hop (safe only if the port is closed to the outside).
# A list: 10.0.0.0/8,loopback. "*" / "true" / 0.0.0.0/0 are NOT ACCEPTED.
TRUSTED_PROXIES=
# Browser origins besides FRONTEND_URL (comma-separated, exact origins).
CORS_ORIGINS=
# Allow WebSocket clients without an Origin header (browsers always send one).
WS_ALLOW_MISSING_ORIGIN=false

# --- Network ---
# The interface the API listens on. 127.0.0.1 = this machine only (the right
# choice when the HTTPS proxy is on this server). Use 0.0.0.0 only on a trusted
# internal network, with its own firewall.
LEGION_BIND_ADDRESS=127.0.0.1

# --- Postgres (REQUIRED) ---
# Legion runs on Postgres. `npm run setup` creates this for you;
# if you configure it by hand, install and start PostgreSQL first.
DATABASE_URL=postgresql://legion:legion@localhost:5432/legion
# Connection pool size (per instance)
DB_POOL_MAX=10
# Row-level security for the workspace-first tables (TENANT-ISOLATION.md, F-04): off | enforce.
# Binds only when the API's role does not own the tables (owner/runtime split, the Docker default).
DB_RLS=off
# true for a managed Postgres (RDS, Neon, Supabase).
# The certificate IS verified. If the provider uses a custom CA, give it below.
DB_SSL=false
# CA bundle: PEM text or a file path. Empty = Node's default trust store.
DB_SSL_CA=
# ONLY for local experiments. Turns off certificate verification; the server
# refuses to start with it against a remote database.
DB_SSL_INSECURE=false

# --- Redis (rate limiting) ---
# Optional for a single instance. REQUIRED if you run MORE THAN ONE instance,
# for two reasons:
#   1) without Redis each instance counts the limit separately (3 pods = 3x the limit)
#   2) live alerts reach only the clients connected to that instance
# If Redis is down the server still starts: limits are counted per instance,
# and live alerts are delivered locally.
REDIS_URL=
# Per-minute limit for auth endpoints (per IP)
AUTH_RATE_LIMIT=10
# Per-minute limit for the rest of the API. The Wazuh webhook and /health are not limited.
API_RATE_LIMIT=300
# Close an idle TCP connection that has not sent its first request, in seconds. 0 = off.
# Protects against tying up memory/file descriptors with thousands of idle connections.
HTTP_FIRST_REQUEST_TIMEOUT_SECONDS=15
# Cloudflare Turnstile (CAPTCHA) — optional. The secret key (Cloudflare → Turnstile).
# When set: sign-in, sign-up and password reset are not accepted without the check.
# The dashboard needs the matching SITE key: frontend/.env.local → NEXT_PUBLIC_TURNSTILE_SITE_KEY.
TURNSTILE_SECRET_KEY=
# Size of the reserved queue for known devices (those that fully signed in from
# this browser before). 0 = default (equal to the normal queue). DEPLOY-ONLINE.md §12.8.
PASSWORD_HASH_MAX_PRIORITY=0

# --- Sessions ---
# The access token is short: it is stateless and cannot be revoked.
ACCESS_TOKEN_MINUTES=15
# The refresh token is stored in the database, rotated on every use, and revocable.
REFRESH_TOKEN_DAYS=30

# --- MFA ---
# The name shown in the user's authenticator app
MFA_ISSUER=Legion

# --- Import from the old JSON store (one-off) ---
# npm run import:json -- ./data/legion.json
DATA_FILE=./data/legion.json

# --- Run mode ---
# Security checks run whatever NODE_ENV is; the server refuses to start when:
#   - JWT_SECRET is missing, a template value, or shorter than 32 characters
#   - FRONTEND_URL is https:// but COOKIE_SECURE is not true
#   - a remote database is used with certificate verification off
# The demo account (admin@legion.demo) is NEVER created in production —
# the first account is created through /setup with the one-time setup token.
# NODE_ENV=development   # only for `npm run dev` on a laptop; do not set it on a server
# To turn off demo data in development: false
# SEED_DEMO_DATA=true   # demo account (admin@legion.demo / legion123) — only on 127.0.0.1, never in production

# --- Subscription / trial ---
# How many days a new tenant gets full use without paying
TRIAL_DAYS=14
# How many days a team invitation link is valid
INVITE_DAYS=7

# --- Disk writes ---
# Writes are merged inside this window (ms). Sharply reduces the number of
# writes during a large alert stream.
PERSIST_FLUSH_MS=200

# --- AI (optional) ---
# If both keys are empty, Copilot and Oracle give deterministic answers
# and no data leaves your server.
#
# OpenRouter: many vendors' models with one key, including free ones.
# Choose a model: https://openrouter.ai/models — if left empty, the default
# model of your OpenRouter account is used.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Groq — the alternative.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# If both keys are set, OpenRouter is chosen. To use Groq: groq
AI_PROVIDER=

# --- AI safety ---
# AI only advises: it has no tools and cannot change an alert's status.
# Answers are labelled "AI suggestion" in the dashboard.
# Whether AI is on when an organisation has not chosen: on / off / empty.
# Empty = on in self-hosted (the operator chose the provider),
# OFF in hosted (SaaS) — until an administrator turns it on in Settings.
AI_TENANT_DEFAULT=
# How long to wait for the provider (ms, 2000-60000); beyond it Legion's own analysis is used
AI_TIMEOUT_MS=15000
# Maximum characters leaving the server in one request (2000-100000)
AI_MAX_INPUT_CHARS=24000
# Maximum length of a stored/displayed AI answer (500-20000)
AI_MAX_OUTPUT_CHARS=6000
# After this many failures in a row, the provider is not called for AI_BREAKER_COOLDOWN_SECONDS
AI_BREAKER_THRESHOLD=5
AI_BREAKER_COOLDOWN_SECONDS=60
# How many AI requests one organisation may send per minute (per server instance)
AI_RATE_LIMIT_PER_MINUTE=30
# Daily ceiling of AI requests per organisation (UTC day; 0 = no daily cap)
AI_DAILY_LIMIT=1000

# --- Encryption keys (REQUIRED) ---
# Two-factor (TOTP) secrets and webhook secrets are encrypted in the database
# with AES-256-GCM. Format: "id:key[,id:key...]", key — 32 random bytes
# (openssl rand -hex 32). The first one encrypts, all of them decrypt.
# Keep this value SEPARATE from database backups. If it is lost, every user
# with two-factor sign-in enabled is locked out.
# Rotation: put the new key FIRST, keep the old one after it, restart;
# once "npm run secrets -w server -- status" shows the old one is no longer
# used, remove it. The server does not start without a key
# (except with NODE_ENV=development/test).
LEGION_ENCRYPTION_KEYS=
# Optional: which id encrypts (empty = the first one)
LEGION_ENCRYPTION_KEY_ID=
# Developer machines only: with no SMTP, write password-reset and invitation
# links to the log. Ignored in production.
DEV_LOG_AUTH_LINKS=false

# --- Wazuh / security-event webhook ---
# Every organisation has its own random webhook credential (KEY_ID:SECRET).
# An administrator creates it: API (POST /security-events/credentials) or
#   npm run webhook:credential -w server -- create --tenant <uuid>
# Secrets are stored encrypted with LEGION_ENCRYPTION_KEYS (see above).
# DEPRECATED: replaced by LEGION_ENCRYPTION_KEYS. Needed only to read webhook
# secrets created before it; can be removed once "npm run secrets -w server --
# status" shows no legacy-v1.
WEBHOOK_ENCRYPTION_KEY=
# A signature whose time differs from the server clock by more than this many seconds is refused (30-900)
WEBHOOK_MAX_SKEW_SECONDS=300
# On rotation, the old credential keeps working for this many hours (0-168)
WEBHOOK_ROTATION_OVERLAP_HOURS=24
# DEPRECATED: no longer authenticates anything. Used only so alert IDs do not
# change after an upgrade. May be left empty on a new installation.
SECURITY_EVENT_WEBHOOK_SECRET=

# --- Email / SMTP ---
# If empty in development, email is off and invitation/reset links are
# printed to the console. REQUIRED in SaaS mode.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# true for port 465, false for 587 (STARTTLS)
SMTP_SECURE=false
SMTP_FROM=Legion <no-reply@example.com>
# Alerts at this level and above send email: critical | high | medium | low | off
ALERT_EMAIL_MIN_SEVERITY=high

# --- Paddle Billing (optional) ---
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
# One Paddle price per plan and billing period ("<plan>.<month|year>=pri_…"):
#   PADDLE_PLAN_PRICES=starter.month=pri_…,starter.year=pri_…,professional.month=pri_…,professional.year=pri_…,business.month=pri_…,business.year=pri_…
# Enterprise is by agreement (set with: npm run plan -w server -- set --tenant <uuid> --plan enterprise).
PADDLE_PLAN_PRICES=
# One MONTHLY Paddle price per add-on:
#   PADDLE_ADDON_PRICES=agent_security=pri_…,payment_fraud=pri_…,threat_intel=pri_…,endpoints_100=pri_…,ai_credits_5000=pri_…
PADDLE_ADDON_PRICES=
# sandbox | production - must match NEXT_PUBLIC_PADDLE_ENVIRONMENT in the frontend
PADDLE_ENVIRONMENT=sandbox

# --- Alert email retries (optional) ---
# Alert emails that failed are retried: 30s, 1m, 2m, ... (at most 1 hour apart).
NOTIFY_MAX_ATTEMPTS=8
NOTIFY_RETRY_BASE_SECONDS=30
NOTIFY_POLL_SECONDS=15
# Delivered alert emails (recipient + alert text) are deleted after this many days (0 = keep)
NOTIFY_RETENTION_DAYS=30

# --- Logging ---
# One JSON line per HTTP request on stdout: route pattern, status, latency, request id
# (never the URL, query string, body or headers). off = disable.
ACCESS_LOG=on

# --- Backup monitoring (RECOVERY.md) ---
# The status file ops/backup.sh writes; GET /health/backup reads it
# (HEALTH_METRICS_TOKEN is needed too).
BACKUP_STATUS_FILE=
BACKUP_MAX_AGE_HOURS=30
RESTORE_TEST_MAX_AGE_DAYS=8
BACKUP_REQUIRE_OFFSITE=false

# --- Security hardening (2026-09) — all optional; the defaults are safe ---
# Rotating JWT_SECRET without signing everyone out: put the OLD value here,
# set a new JWT_SECRET, remove the old one after ~1 day (comma-separated).
# JWT_PREVIOUS_SECRETS=
# One login's hard maximum life, however active (days).
# SESSION_ABSOLUTE_DAYS=30
# 0 = strict refresh-token reuse detection (recommended; the dashboard
# serialises refresh across tabs itself). See config.ts before changing.
# REFRESH_REUSE_GRACE_SECONDS=0
# Sensor webhook: largest event (bytes) and failed authentications per client
# address per minute before that address is refused.
# WEBHOOK_MAX_BODY_BYTES=1048576
# WEBHOOK_FAILED_AUTH_PER_MINUTE=60
# Wrong current-password / code attempts per signed-in user per 15 minutes.
# STEP_UP_FAILURES=10
# Reset / verification emails per address per hour.
# MAIL_PER_ADDRESS_HOURLY=5
# Concurrent live-alert sockets per user and per tenant (per instance).
# WS_MAX_PER_USER=20
# WS_MAX_PER_TENANT=1000

# --- Global SaaS (GLOBAL-SAAS-ARCHITECTURE.md) ---------------------------------
# The data region this deployment serves. New workspaces are created in it; a
# workspace whose data lives in another region is answered 421 with a pointer.
# LEGION_REGION=eu-central
# Where each region's API is, so a misrouted client can be pointed there.
# LEGION_REGION_URLS=eu-central=https://eu.legion.example,us-east=https://us.legion.example
# Billing currencies (ISO 4217) and the default for new workspaces.
# SUPPORTED_CURRENCIES=USD,EUR
# DEFAULT_CURRENCY=USD
# Paddle price per currency; the server picks the workspace's.
# PADDLE_PRICE_IDS=USD=pri_...,EUR=pri_...   (the older single-plan price; kept so existing subscriptions stay valid)
# Workspaces one person may belong to.
# MAX_WORKSPACES_PER_USER=20
# This instance's name in health output and job leases (default host:pid).
# LEGION_INSTANCE_ID=api-1

# --- Data lifecycle (DATA-RETENTION.md) ----------------------------------------
# Hosted only. Payment checks older than this many months are deleted (default 24).
# RETENTION_PAYMENT_MONTHS=24
# Audit-log e-mail addresses and IPs older than this many months are removed (default 24).
# RETENTION_AUDIT_MONTHS=24
# Agent logs older than this many months are pruned, oldest first (default 24).
# RETENTION_AGENT_LOG_MONTHS=24
# Finished SOC history (policy decisions, finished actions/approvals/jobs/workflows, oldest SOC audit
# events with a chain anchor) is deleted after this many days. 0 = keep forever (the disk fills).
# Default: 365 hosted, 0 self-hosted (docker-compose.pilot.yml sets 365).
# SOC_RETENTION_DAYS=365
# Warn, then erase, workspaces locked longer than this many days. 0 = OFF (default).
# TENANT_AUTO_DELETE_DAYS=0
# Days between the warning e-mail and the erasure (default 30, minimum 7). Needs SMTP: without it nothing is deleted.
# TENANT_DELETE_NOTICE_DAYS=30
# Append-only file OUTSIDE the database listing erased workspaces, so a restored backup can replay them.
# DELETION_LEDGER_FILE=/var/lib/legion/deletions.jsonl

# --- SOC core (Task 10) --------------------------------------------------------
# Policy Engine v0. "shadow" (default): covered actions (manual and automatic
# blocks, unblocks, alert status changes, payment release/reject) are also
# evaluated against the workspace policy and the would-be decision is recorded
# in policy_decisions. It never changes what happens. "off": nothing recorded.
# There is no enforcing value yet.
# POLICY_ENGINE_MODE=shadow
# Background runtime: this process runs queued SOC jobs (action simulations,
# background workflow runs). "off" for an API-only replica.
# RUNTIME_WORKER=on
# RUNTIME_POLL_SECONDS=5
# Run the alert workflow for every NEW alert in the background: "off" (default)
# or "shadow" (each step's decision is recorded; no approval requests; nothing done).
# ORCHESTRATOR_AUTO_MODE=off
# Key of the SOC audit chain (HMAC-SHA256 over every SOC-core event). Unset:
# derived from JWT_SECRET. Set it once and keep it: a new key (or a new
# JWT_SECRET while this is unset) makes older events fail verification.
# SOC_AUDIT_KEY=

# Resource budget: action requests per workspace per hour (429 beyond it). Each costs ~6.5 KB of
# append-only history, so this bounds how fast one workspace can grow the database. Default 3000.
# SOC_ACTIONS_PER_HOUR=3000
