PORT=8000
FRONTEND_URL=http://localhost:3000
# Bo'sh qoldiring va `npm run setup` ishga tushiring: u tasodifiy qiymat yozadi.
# Shablon qiymatlar (replace-with…, change-me…) bilan server ishga tushmaydi.
JWT_SECRET=
COOKIE_SECURE=false
# Yangi-brauzer ko'radigan /auth/refresh yo'li. To'g'ridan-to'g'ri: /auth.
# nginx orqasida ("/api" kesib tashlanadi): /api/auth — aks holda refresh
# cookie brauzerdan qaytmaydi va sessiya access token tugagach uziladi.
REFRESH_COOKIE_PATH=/auth
# Qaysi proksi mijozning haqiqiy IP'sini (X-Forwarded-For) ayta oladi.
# Bo'sh = faqat loopback (shu serverdagi nginx). "none" = hech kim.
# "1" = oxirgi bitta hop (faqat port tashqaridan yopiq bo'lsa xavfsiz).
# Ro'yxat: 10.0.0.0/8,loopback. "*" / "true" / 0.0.0.0/0 QABUL QILINMAYDI.
TRUSTED_PROXIES=
# FRONTEND_URL'dan tashqari brauzer originlari (vergul bilan, aniq origin).
CORS_ORIGINS=
# WebSocket'da Origin sarlavhasi yo'q mijozlarga ruxsat (brauzerlar doim yuboradi).
WS_ALLOW_MISSING_ORIGIN=false

# --- Tarmoq ---
# API qaysi interfeysda tinglaydi. 127.0.0.1 = faqat shu mashina (HTTPS proxy
# shu serverda bo'lganda to'g'ri tanlov). 0.0.0.0'ni faqat ishonchli ichki
# tarmoqda, o'z firewall'i bilan qo'ying.
LEGION_BIND_ADDRESS=127.0.0.1

# --- Postgres (MAJBURIY) ---
# Legion Postgres'da ishlaydi. `npm run setup` buni siz uchun yaratadi;
# qo'lda sozlasangiz, PostgreSQL'ni avval o'rnating va ishga tushiring.
DATABASE_URL=postgresql://legion:legion@localhost:5432/legion
# Ulanishlar hovuzi hajmi (instansiya boshiga)
DB_POOL_MAX=10
# Boshqariladigan Postgres (RDS, Neon, Supabase) uchun true.
# Sertifikat TEKSHIRILADI. Provayder maxsus CA ishlatsa, quyida bering.
DB_SSL=false
# CA bundle: PEM matni yoki fayl yo'li. Bo'sh bo'lsa Node'ning standart
# ishonch ro'yxati ishlatiladi.
DB_SSL_CA=
# FAQAT lokal tajriba uchun. Sertifikat tekshiruvini o'chiradi va
# production'da server ishga tushishdan bosh tortadi.
DB_SSL_INSECURE=false

# --- Redis (rate limit) ---
# Bitta instansiya uchun ixtiyoriy. BIRDAN ORTIQ instansiya ishlatsangiz
# MAJBURIY, ikki sabab bilan:
#   1) Redis'siz har instansiya limitni alohida hisoblaydi (3 pod = 3x limit)
#   2) Realtime alertlar faqat o'sha instansiyaga ulangan klientlarga yetadi
# Redis o'chiq bo'lsa server baribir ko'tariladi: limit instansiya ichida
# hisoblanadi, realtime esa lokal yetkaziladi.
REDIS_URL=
# Auth endpointlari uchun daqiqasiga limit (IP bo'yicha)
AUTH_RATE_LIMIT=10
# Qolgan API uchun daqiqasiga limit. Wazuh webhook va /health cheklanmaydi.
API_RATE_LIMIT=300

# --- Sessiyalar ---
# Access token qisqa: u stateless va bekor qilib bo'lmaydi.
ACCESS_TOKEN_MINUTES=15
# Refresh token bazada saqlanadi, har ishlatishda almashadi va bekor qilinadi.
REFRESH_TOKEN_DAYS=30

# --- MFA ---
# Foydalanuvchining authenticator ilovasida ko'rinadigan nom
MFA_ISSUER=Legion

# --- Eski JSON bazadan ko'chirish (bir martalik) ---
# npm run import:json -- ./data/legion.json
DATA_FILE=./data/legion.json

# --- Ishga tushirish rejimi ---
# NODE_ENV=production bo'lganda server quyidagilarni majburiy tekshiradi va
# shartlar bajarilmasa umuman ishga tushmaydi:
#   - JWT_SECRET tasodifiy va 32+ belgidan iborat
#   - COOKIE_SECURE=true
#   - FRONTEND_URL https:// bilan boshlanadi
#   - SMTP_HOST to'ldirilgan
# Shuningdek production'da demo hisob (admin@legion.demo) HECH QACHON
# yaratilmaydi — birinchi hisob POST /auth/register orqali ochiladi.
# NODE_ENV=development   # faqat noutbukda `npm run dev` uchun; server uchun o'rnatmang
# Dev'da demo ma'lumotni o'chirish uchun: false
# SEED_DEMO_DATA=true   # demo hisob (admin@legion.demo / legion123) — faqat 127.0.0.1 da, hech qachon production'da

# --- Obuna / sinov muddati ---
# Yangi tenant to'lovsiz necha kun to'liq foydalanadi
TRIAL_DAYS=14
# Jamoa taklifi linki necha kun amal qiladi
INVITE_DAYS=7

# --- Diskka yozish ---
# Yozuvlar shu oyna ichida birlashtiriladi (ms). Katta alert oqimida
# yozuvlar sonini keskin kamaytiradi.
PERSIST_FLUSH_MS=200

# --- AI (ixtiyoriy) ---
# Ikkala kalit ham bo'sh bo'lsa, Copilot va Oracle deterministik javob beradi
# va serveringizdan hech qanday ma'lumot chiqmaydi.
#
# OpenRouter: bitta kalit bilan ko'p sotuvchining modellari, jumladan bepullari.
# Model tanlash: https://openrouter.ai/models — bo'sh qoldirsangiz, OpenRouter
# hisobingizdagi standart model ishlatiladi.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Groq — muqobil variant.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Ikkala kalit ham qo'yilsa OpenRouter tanlanadi. Groq kerak bo'lsa: groq
AI_PROVIDER=

# --- AI xavfsizligi ---
# AI faqat maslahat beradi: hech qanday vositasi (tool) yo'q, ogohlantirish
# holatini o'zgartira olmaydi. Javoblar dashboardda "AI taklifi" deb belgilanadi.
# Tashkilot tanlov qilmagan bo'lsa AI yoqilganmi: on / off / bo'sh.
# Bo'sh = self-hosted'da yoqilgan (operator provayderni o'zi tanlagan),
# hosted (SaaS)'da O'CHIRILGAN — administrator Settings'da yoqmaguncha.
AI_TENANT_DEFAULT=
# Provayderdan javob kutish (ms, 2000-60000); oshsa Legion'ning o'z tahlili ishlatiladi
AI_TIMEOUT_MS=15000
# Bir so'rovda serverdan chiqadigan eng ko'p belgi (2000-100000)
AI_MAX_INPUT_CHARS=24000
# Saqlanadigan/ko'rsatiladigan AI javobining eng ko'p uzunligi (500-20000)
AI_MAX_OUTPUT_CHARS=6000
# Ketma-ket shuncha xatodan keyin provayder AI_BREAKER_COOLDOWN_SECONDS davomida chaqirilmaydi
AI_BREAKER_THRESHOLD=5
AI_BREAKER_COOLDOWN_SECONDS=60
# Bir tashkilot daqiqasiga nechta AI so'rovi yubora oladi (har bir server nusxasi uchun)
AI_RATE_LIMIT_PER_MINUTE=30

# --- Shifrlash kalitlari (MAJBURIY) ---
# Ikki bosqichli (TOTP) sirlar va webhook sirlari bazada AES-256-GCM bilan
# shifrlanadi. Format: "id:kalit[,id:kalit...]", kalit — 32 tasodifiy bayt
# (openssl rand -hex 32). Birinchisi shifrlaydi, hammasi ochadi.
# Bu qiymatni bazaning zaxira nusxasidan ALOHIDA saqlang. Yo'qotilsa, ikki
# bosqichli kirishi yoqilgan har bir foydalanuvchi kira olmaydi.
# Almashtirish: yangi kalitni BIRINCHI qo'ying, eskisini ortidan qoldiring,
# qayta ishga tushiring; "npm run secrets -w server -- status" eskisi bo'shaganini
# ko'rsatgach, eskisini o'chiring. Kalitsiz server ishga tushmaydi
# (NODE_ENV=development/test bundan mustasno).
LEGION_ENCRYPTION_KEYS=
# Ixtiyoriy: qaysi id shifrlaydi (bo'sh = birinchisi)
LEGION_ENCRYPTION_KEY_ID=
# Faqat dasturchi kompyuterida: SMTP yo'q bo'lsa parolni tiklash va taklif
# havolalarini logga chiqarish. Production'da e'tiborga olinmaydi.
DEV_LOG_AUTH_LINKS=false

# --- Wazuh / xavfsizlik hodisalari webhook ---
# Har bir tashkilotning o'z tasodifiy webhook kaliti bor (KEY_ID:SECRET). Uni
# administrator yaratadi: API (POST /security-events/credentials) yoki
#   npm run webhook:credential -w server -- create --tenant <uuid>
# Sirlar bazada LEGION_ENCRYPTION_KEYS bilan shifrlangan holda saqlanadi (yuqoriga qarang).
# ESKIRGAN: LEGION_ENCRYPTION_KEYS o'rnini egalladi. Faqat undan oldin
# yaratilgan webhook sirlarini o'qish uchun kerak; "npm run secrets -w server --
# status" legacy-v1 ko'rsatmasa, o'chirish mumkin.
WEBHOOK_ENCRYPTION_KEY=
# Imzo vaqti server soatidan shuncha soniyadan ko'p farq qilsa rad etiladi (30-900)
WEBHOOK_MAX_SKEW_SECONDS=300
# Aylantirishda (rotate) eski kalit yana shuncha soat ishlaydi (0-168)
WEBHOOK_ROTATION_OVERLAP_HOURS=24
# ESKIRGAN: endi hech narsani autentifikatsiya QILMAYDI. Faqat yangilashdan
# keyin alert ID'lari o'zgarmasligi uchun ishlatiladi. Yangi o'rnatishda bo'sh qolishi mumkin.
SECURITY_EVENT_WEBHOOK_SECRET=

# --- Email / SMTP ---
# Dev'da bo'sh qoldirilsa email o'chiq bo'ladi va taklif/tiklash linklari
# konsolga chiqariladi. Production'da MAJBURIY.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# 465-port uchun true, 587 (STARTTLS) uchun false
SMTP_SECURE=false
SMTP_FROM=Legion <no-reply@example.com>
# Shu darajadan yuqori alertlar email yuboradi: critical | high | medium | low | off
ALERT_EMAIL_MIN_SEVERITY=high

# --- Paddle Billing (ixtiyoriy) ---
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
# sandbox | production - frontenddagi NEXT_PUBLIC_PADDLE_ENVIRONMENT bilan bir xil bo'lsin
PADDLE_ENVIRONMENT=sandbox

# --- Alert email retries (ixtiyoriy) ---
# Xato bilan tugagan alert email'lari qayta yuboriladi: 30s, 1m, 2m, ... (max 1 soat oraliq).
NOTIFY_MAX_ATTEMPTS=8
NOTIFY_RETRY_BASE_SECONDS=30
NOTIFY_POLL_SECONDS=15

# --- Backup monitoring (RECOVERY.md) ---
# ops/backup.sh yozadigan holat fayli; GET /health/backup shuni o'qiydi
# (HEALTH_METRICS_TOKEN ham kerak).
BACKUP_STATUS_FILE=
BACKUP_MAX_AGE_HOURS=30
RESTORE_TEST_MAX_AGE_DAYS=8
BACKUP_REQUIRE_OFFSITE=false
