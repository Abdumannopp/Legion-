NEXT_PUBLIC_API_URL=http://localhost:8000
# WebSocket endpoint for realtime alerts. Optional — if unset it is derived
# from NEXT_PUBLIC_API_URL (http -> ws, https -> wss).
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# The organisation running this installation. Shown on the privacy and terms
# pages, which describe your deployment — not a hosted service. If you leave
# these empty the pages say "[the organisation running this installation]"
# rather than quietly naming someone else.
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_SUPPORT_EMAIL=

# Paddle Billing (client-side) — see server/.env.example for the
# server-side PADDLE_API_KEY / PADDLE_WEBHOOK_SECRET.
# Client-side token (Developer Tools -> Authentication -> Client-side tokens)
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# "sandbox" while testing, "production" once you go live — must match
# the backend's PADDLE_ENVIRONMENT
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox
# The Paddle Price ID (starts with pri_) for the plan shown on /billing
NEXT_PUBLIC_PADDLE_PRICE_ID=
