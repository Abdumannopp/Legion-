# Legion CONTROLLED PILOT — copy to .env.pilot, chmod 600, fill every CHANGE-ME.
# Never commit the filled file. Used by docker-compose.pilot.yml (--env-file) and
# by `node ops/pilot-preflight.mjs --env .env.pilot`.
#
# Generate secrets with:  openssl rand -hex 32
#
# The pilot switches (NODE_ENV, simulation/shadow modes, no demo data,
# secure cookies) are fixed in docker-compose.pilot.yml and are NOT set here.

# --- database (two different passwords: the admin one never reaches the API) --
POSTGRES_ADMIN_USER=legion_admin
POSTGRES_ADMIN_PASSWORD=CHANGE-ME
APP_DB_PASSWORD=CHANGE-ME
POSTGRES_DB=legion

# --- secrets (all different from each other, 32+ random characters) ----------
JWT_SECRET=CHANGE-ME
# Encrypts MFA seeds and webhook secrets at rest. Format: "keyid:<64 hex chars>" (e.g. k1:$(openssl rand -hex 32)); old keys stay listed (comma-separated) after a rotation.
LEGION_ENCRYPTION_KEYS=CHANGE-ME
# Key of the SOC audit chain. Set it once, back it up SEPARATELY from the database backup.
SOC_AUDIT_KEY=CHANGE-ME
# Bearer token for /metrics and /health/* (Prometheus reads it from a file, see monitoring/).
HEALTH_METRICS_TOKEN=CHANGE-ME

# --- addresses ---------------------------------------------------------------
FRONTEND_URL=https://legion-pilot.example.com
CORS_ORIGINS=https://legion-pilot.example.com
# nginx on the same host reaches the containers over loopback / the docker bridge.
TRUSTED_PROXIES=127.0.0.1,172.16.0.0/12
REFRESH_COOKIE_PATH=/api/auth
NEXT_PUBLIC_API_URL=https://legion-pilot.example.com/api
NEXT_PUBLIC_WS_URL=wss://legion-pilot.example.com/api
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_SUPPORT_EMAIL=

# --- mail (required in production: password resets, invitations, alerts) -----
SMTP_HOST=CHANGE-ME
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Legion Pilot <no-reply@example.com>
ALERT_EMAIL_MIN_SEVERITY=high
# Finished SOC history older than this many days is deleted (0 = keep forever). Default 365.
SOC_RETENTION_DAYS=365

# --- AI: leave empty for the pilot unless the data-processing terms are signed --
AI_PROVIDER=
OPENROUTER_API_KEY=
GROQ_API_KEY=

# --- ports on 127.0.0.1 (nginx is the only public listener) -------------------
API_PORT=8000
WEB_PORT=3000
