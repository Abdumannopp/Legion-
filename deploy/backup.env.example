# /etc/legion/backup.env — read by legion-backup.service. Mode 600.
# Holds the database login and alert URLs. It does NOT hold, and must never
# hold, the backup PRIVATE key (RECOVERY.md).

DATABASE_URL=postgresql://legion:CHANGE-ME@127.0.0.1:5432/legion
# A connection that can CREATE DATABASE (e.g. the postgres superuser over the
# local socket). Enables the restore test on EVERY backup.
DATABASE_ADMIN_URL=postgresql://postgres@/postgres?host=/var/run/postgresql

BACKUP_DIR=/var/backups/legion
BACKUP_STATUS_FILE=/var/lib/legion-backup/backup-status.json

# PUBLIC key(s) from `age-keygen` (line "Public key: age1…"). Two or more,
# comma-separated, so the loss of one private key does not lose the backups.
BACKUP_AGE_RECIPIENTS=age1REPLACE-WITH-YOUR-PUBLIC-KEY

# Retention of LOCAL copies (off-server retention is the storage's lifecycle rule).
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
BACKUP_KEEP_MONTHLY=12

# Off-server copy. Runs with $BACKUP_FILE and $BACKUP_CHECKSUM_FILE set.
# Examples (pick one; RECOVERY.md has more):
#   BACKUP_UPLOAD_CMD='aws s3 cp "$BACKUP_FILE" s3://YOUR-BUCKET/legion/ && aws s3 cp "$BACKUP_CHECKSUM_FILE" s3://YOUR-BUCKET/legion/'
#   BACKUP_UPLOAD_CMD='rclone copy "$BACKUP_FILE" remote:legion-backups/'
#   BACKUP_UPLOAD_CMD='scp -i /etc/legion/backup_ed25519 "$BACKUP_FILE" "$BACKUP_CHECKSUM_FILE" backup@other-host:/srv/legion/'
BACKUP_UPLOAD_CMD=
BACKUP_REQUIRE_OFFSITE=true

# Where failures are reported. At least one, and test it (RECOVERY.md).
ALERT_WEBHOOK_URL=
ALERT_EMAIL_TO=
# Dead-man's switch (healthchecks.io / Uptime Kuma "push"): pinged on success.
HEALTHCHECK_PING_URL=
