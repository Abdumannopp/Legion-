  },
  "dependencies": {
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^22.19.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "express": "^5.1.0",
    "pg": "^8.23.0",
    "supertest": "^7.2.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
