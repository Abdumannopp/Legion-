PORT=3000
# Production is the default. Set NODE_ENV=development ONLY on your own machine (seeds demo users).
NODE_ENV=development
DATABASE_PATH=./data/veyra.db
JWT_SECRET=
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=120
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=8
LOGIN_RATE_LIMIT_IP_MAX=30
LOGIN_FAILURE_LOG_THRESHOLD=4
REGISTER_RATE_LIMIT_WINDOW_MS=3600000
REGISTER_RATE_LIMIT_MAX=5
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
ALLOWED_ORIGIN=
# Optional: when set, /api/register requires this invite code. Leave empty for open registration.
REGISTRATION_INVITE_CODE=
