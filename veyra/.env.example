PORT=3000
# production is the safe default (no demo users, sign-up closed).
# Use NODE_ENV=development ONLY on your own computer: it creates demo accounts with public passwords.
NODE_ENV=production
# Optional. Development listens on 127.0.0.1 only; production on 0.0.0.0.
HOST=
DATABASE_PATH=./data/veyra.db
JWT_SECRET=

# Name of the first company (tenant 1). More companies are added in the app (Companies panel).
COMPANY_NAME=

# Region settings
# kg or lb
WEIGHT_UNIT=kg
# ISO currency code shown on prices, e.g. USD, EUR, UZS, KZT
CURRENCY=USD
# Largest allowed price. Raise it for currencies with big numbers (e.g. UZS: 10000000000).
MAX_RATE=10000000

# ---------- AI agents ----------
# FLOW (reads order messages) needs an OpenRouter key: https://openrouter.ai/keys
# Empty = AI is off and nothing is sent outside the server. SCOUT and RELAY drafts work without it.
OPENROUTER_API_KEY=
# Optional model id from openrouter.ai/models. Empty = your OpenRouter account's default model.
OPENROUTER_MODEL=
# AI requests per person per hour (cost control)
AI_RATE_LIMIT_PER_HOUR=60

# ---------- SMS / WhatsApp (RELAY) ----------
# Empty = messages are drafted and can be copied, but not sent automatically.
MESSAGING_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sender numbers in international format, e.g. +15551234567 (leave one empty to switch that channel off)
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
# Language of drafted messages: uz, ru or en
MESSAGE_LANGUAGE=uz
MESSAGE_RATE_LIMIT_PER_HOUR=60

# ---------- GPS ----------
# Each company creates its own GPS token in the app (Integrations → Create GPS token).
# Positions closer together than this are not stored again.
GPS_MIN_INTERVAL_MINUTES=15
GPS_RATE_LIMIT_PER_MINUTE=600
# A booked truck with no location update for this long is flagged.
STALE_TRACKING_HOURS=12

# Sign-up. In production nobody can self-register unless one of these is set;
# the administrator adds people from the dashboard (Team Access → Add user).
# REGISTRATION_INVITE_CODE: people may sign up with this code (they become operators).
REGISTRATION_INVITE_CODE=
# ALLOW_OPEN_REGISTRATION=true: anyone may sign up (not recommended for real customer data).
ALLOW_OPEN_REGISTRATION=

# First administrator, created on the first production start (password 12+ characters).
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
ALLOWED_ORIGIN=

API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=120
LOGIN_RATE_LIMIT_WINDOW_MS=900000
# Failed logins per account from one address
LOGIN_RATE_LIMIT_MAX=8
# Failed logins per address (all accounts)
LOGIN_RATE_LIMIT_IP_MAX=30
# Failed logins per account from all addresses together
LOGIN_RATE_LIMIT_ACCOUNT_MAX=30
LOGIN_FAILURE_LOG_THRESHOLD=4
REGISTER_RATE_LIMIT_WINDOW_MS=3600000
REGISTER_RATE_LIMIT_MAX=5
# Password hashing cost (10-14). Higher is slower and stronger.
BCRYPT_COST=12
