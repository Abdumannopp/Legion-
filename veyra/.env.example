PORT=3000
# production is the safe default (no demo users, sign-up closed).
# Use NODE_ENV=development ONLY on your own computer: it creates demo accounts with public passwords.
NODE_ENV=production
# Optional. Development listens on 127.0.0.1 only; production on 0.0.0.0.
HOST=
DATABASE_PATH=./data/veyra.db
JWT_SECRET=

# Region settings
# kg or lb
WEIGHT_UNIT=kg
# ISO currency code shown on prices, e.g. USD, EUR, UZS, KZT
CURRENCY=USD
# Largest allowed price. Raise it for currencies with big numbers (e.g. UZS: 10000000000).
MAX_RATE=10000000

# Sign-up. In production nobody can self-register unless one of these is set;
# the administrator adds people from the dashboard (Team Access → Add user).
# REGISTRATION_INVITE_CODE: people may sign up with this code (they become operators).
REGISTRATION_INVITE_CODE=
# ALLOW_OPEN_REGISTRATION=true: anyone may sign up (not recommended for real customer data).
ALLOW_OPEN_REGISTRATION=

# First administrator, created on the first production start (password 12+ characters).
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
ALLOWED_ORIGIN=

API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=120
LOGIN_RATE_LIMIT_WINDOW_MS=900000
# Failed logins per account from one address
LOGIN_RATE_LIMIT_MAX=8
# Failed logins per address (all accounts)
LOGIN_RATE_LIMIT_IP_MAX=30
# Failed logins per account from all addresses together
LOGIN_RATE_LIMIT_ACCOUNT_MAX=30
LOGIN_FAILURE_LOG_THRESHOLD=4
REGISTER_RATE_LIMIT_WINDOW_MS=3600000
REGISTER_RATE_LIMIT_MAX=5
# Password hashing cost (10-14). Higher is slower and stronger.
BCRYPT_COST=12
